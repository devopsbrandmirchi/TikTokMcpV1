# Public origin of this connector. No trailing slash.
# Local: http://localhost:3000
# Cloud Run: https://YOUR-SERVICE-HASH.REGION.run.app
APP_BASE_URL=http://localhost:3000

# TikTok Marketing API developer app credentials
# From https://business-api.tiktok.com/portal
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# The single advertiser account this V1 deployment is allowed to query.
# Never hard-code this in source. Claude does not pass this ID.
TIKTOK_ADVERTISER_ID=

# Optional override. Defaults to {APP_BASE_URL}/oauth/tiktok/callback
# TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok/callback

# Optional API base override. Default is official v1.3 production.
# TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3

# MCP OAuth JWT signing secret (HS256). Use a long random string.
MCP_TOKEN_SECRET=

# Signs TikTok OAuth state and encrypts OAuth cookies.
OAUTH_STATE_SECRET=

# AES-256-GCM key for TikTok tokens at rest.
# 64 hex characters, or any string (hashed to 32 bytes).
TOKEN_ENCRYPTION_KEY=

# Local encrypted token file. Gitignored. Default: .data/tiktok-tokens.enc
# TIKTOK_TOKEN_STORE_PATH=.data/tiktok-tokens.enc

# Cloud Run: persist rotated TikTok tokens in Secret Manager.
# When both are set, Secret Manager is used instead of the local file.
# GOOGLE_CLOUD_PROJECT=
# TIKTOK_TOKEN_SECRET_NAME=tiktok-mcp-v1-tokens

# Optional pre-registered Claude Advanced Settings client
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=

NODE_ENV=development
LOG_LEVEL=info

# Optional live tests against the real Marketing API. Default: skip.
# TIKTOK_LIVE_TEST=true
